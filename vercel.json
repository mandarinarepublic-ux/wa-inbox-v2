{
  "framework": "nextjs",
  "regions": [
    "gru1"
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)docs' ':(exclude)*.md' ':(exclude).github' ':(exclude).githooks' ':(exclude)tests' ':(exclude).claude'",
  "crons": [
    {
      "path": "/api/cron/seguimientos",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/pendientes",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/entregas",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/pagos",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/flujos",
      "schedule": "*/5 * * * *"
    }
  ]
}
