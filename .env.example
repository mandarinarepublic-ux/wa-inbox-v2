# Google Service Account — mismo que usa MANDARINA CRM
GOOGLE_SERVICE_ACCOUNT_EMAIL=mandarina-pro-sheets@gen-lang-client-0034534950.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Sheets — WhatsAppMandarinaSales
SHEET_ID=1ZQ_vIhKsDBnAUjitOB3zP-4MDbdmsv7hdDgnqNbOkak

# ── WhatsApp Cloud API (Meta) — envío y recepción DIRECTOS (ya no se usa Make) ──
# Token de Usuario del Sistema (permanente) con permisos whatsapp_business_messaging.
META_TOKEN=EAA...
# Phone Number ID del número de WhatsApp Business.
META_PHONE_ID=1024077200794372
# Verify Token del webhook: inventa un string aleatorio y ponlo IGUAL en
# Meta → WhatsApp → Configuration → Callback URL (https://wa-inbox-v2.vercel.app/api/webhook).
WHATSAPP_VERIFY_TOKEN=

# ── dLocal Go — links de pago (LINKPAGO<monto>) ────────────────────────────────
# Vienen juntas como "clave:secreto".
DLOCAL_API_KEY=
DLOCAL_SECRET=
# A dónde avisa dLocal cuando cambia el estado de un pago. El `?k=` es la llave
# compartida: dLocal NO firma sus notificaciones, así que es lo único que
# distingue una llamada real de cualquiera que conozca la URL.
DLOCAL_NOTIFY_URL=https://wa-inbox-v2.vercel.app/api/pago-dlocal?k=<secreto>
# El MISMO valor que va en `?k=`. Mientras esté vacío, la ruta acepta todo (para
# no cortar los links ya emitidos); en cuanto se setea, exige la llave.
DLOCAL_NOTIFY_SECRET=

# (OBSOLETO) Make ya no envía ni recibe mensajes. Se conserva solo por referencia.
# MAKE_SEND_WEBHOOK=https://hook.us2.make.com/2j5dzq4gjqkjjnyxiyb46bons15awy2k
